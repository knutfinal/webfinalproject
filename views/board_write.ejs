<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>동네 소식 쓰기 - 중고마켓 동네생활</title>

    <link href="/krds/css/token/krds_tokens.css" rel="stylesheet" />
    <link href="/krds/css/common/common.css" rel="stylesheet" />
    <link href="/krds/css/component/component.css" rel="stylesheet" />
    <script defer src="/krds/js/component/ui-script.js"></script>

    <style>
        body { background-color: #ffffff; } 
        #krds-footer { background-color: #f4f6f9; margin-top: 80px; padding: 30px 0; border-top: 1px solid #e9ecef; }
        
        .btn-logout-fix::before, .btn-logout-fix::after { display: none !important; }
        .btn-logout-fix { display: inline-flex !important; flex-direction: row !important; align-items: center !important; gap: 4px !important; width: auto !important; white-space: nowrap !important; }
        .btn-logout-fix svg { display: block !important; margin: 0 !important; }
        
        .header-branding { display: flex; align-items: center; width: 100%; }
        .header-branding .logo, .header-branding .logo a { background: none !important; background-image: none !important; margin: 0; display: flex; align-items: center; }

        .subpage-container { max-width: 1000px; margin: 60px auto; padding: 0 20px; min-height: 50vh; }
        
        .subTit h3 { font-size: 2.8rem; font-weight: 700; color: #111; margin-bottom: 20px; }

        .cl_type { width: 100%; }
        .default_order { display: flex; justify-content: space-between; background: #f8f9fa; border: 1px solid #ced4da; border-radius: 8px; margin-bottom: 40px; overflow: hidden; }
        .order_item { flex: 1; text-align: center; padding: 20px 0; font-size: 1.6rem; color: #868e96; font-weight: 500; position: relative; }
        .order_item.on { background: #246beb; color: #fff; font-weight: 700; }
        .order_item em { font-style: normal; display: block; font-size: 1.3rem; margin-bottom: 5px; opacity: 0.8; }
        .order_item:not(:last-child)::after { content: ''; position: absolute; right: 0; top: 20%; height: 60%; width: 1px; background: #ced4da; }
        .order_item.on::after { display: none; }

        .mw_Input { border-top: 2px solid #222; }
        .mwInput_box { padding: 30px 20px; border-bottom: 1px solid #e9ecef; }
        .mwInput_box .mwTit { display: block; font-size: 1.8rem; font-weight: 700; color: #333; margin-bottom: 15px; }
        .red { color: #e03131; margin-left: 5px; }
        .hide { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0; }
        
        .mwI_full { width: 100%; padding: 12px 15px; font-size: 1.6rem; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box; outline: none; transition: border-color 0.2s; }
        .mwI_full:focus, .ta_box textarea:focus { border-color: #246beb; }
        
        .ta_box { position: relative; }
        .ta_box textarea { width: 100%; min-height: 300px; padding: 15px; font-size: 1.6rem; border: 1px solid #ced4da; border-radius: 4px; box-sizing: border-box; outline: none; resize: vertical; line-height: 1.6; }

        .btnAreaLR { display: flex; justify-content: space-between; align-items: center; margin-top: 30px; padding-top: 20px; }
        .btnAreaLR .btn { padding: 14px 40px; font-size: 1.6rem; font-weight: bold; border-radius: 4px; text-decoration: none; display: inline-block; cursor: pointer; text-align: center; border: none; }
        .btnAreaLR .btn.gray { background: #f1f3f5; color: #495057; border: 1px solid #ced4da; transition: 0.2s; }
        .btnAreaLR .btn.gray:hover { background: #e9ecef; }
        .btnAreaLR .btn.fill { background: #246beb; color: #fff; transition: 0.2s; }
        .btnAreaLR .btn.fill:hover { background: #1d56bc; }
        .krds-main-menu .gnb-menu > li > .gnb-main-trigger::after {
    display: none !important;
}
    </style>
</head>
<body>
<div id="wrap" class="g-wrap">

    <header id="krds-header">
        <div class="header-in">
            <div class="header-container">
                <div class="inner">
                    <div class="header-branding">
                        <h1 class="logo">
                            <a href="/" style="display: block;">
                                <img src="/sitelogo.png" alt="사이트 로고" style="height: 45px; width: auto; max-width: 100%; object-fit: contain;">
                            </a>
                        </h1>

                        <div class="header-actions" style="margin-left: auto;">
                            <% if (user) { %>
                                <span class="btn-navi my" style="background:none; cursor:default;">
                                    <strong><%= user.username %></strong>님
                                </span>
                                <a href="/logout" class="btn-navi btn-logout-fix" style="text-decoration: none; color: #333;">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-top:-2px;">
                                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                        <polyline points="16 17 21 12 16 7"></polyline>
                                        <line x1="21" y1="12" x2="9" y2="12"></line>
                                    </svg>
                                    <span>로그아웃</span>
                                </a>
                            <% } else { %>
                                <a href="/login" class="btn-navi login">로그인</a>
                                <a href="/signup" class="btn-navi join">회원가입</a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <nav class="krds-main-menu">
                <div class="inner">
                    <ul class="gnb-menu" aria-label="메인 메뉴">
                        <li><button type="button" class="gnb-main-trigger" onclick="location.href='/info'">서비스 안내</button></li>
                        <li><button type="button" class="gnb-main-trigger" onclick="location.href='/board'">게시판</button></li>
                        <li><button type="button" class="gnb-main-trigger" onclick="location.href='/friends'">친구 관리</button></li>
                        <li><button type="button" class="gnb-main-trigger" onclick="location.href='/items'">판매 물품 정보</button></li>
                    </ul>
                </div>
            </nav>
        </div>
    </header>

    <div id="container" class="subpage-container">
        
        <div id="div_frmDsgnType" class="cl_type">
            <div class="default_order">
                <div class="order_item icon_1 on">
                    <span title="현재 작성 단계"><em>1단계</em> 게시글 작성</span>
                    <span class="hide">현단계 진행 중 입니다.</span>
                </div>
                <div class="order_item icon_3">
                    <span id="span_step3" title="작성완료 단계"><em>2단계</em> 작성완료</span>
                </div>
            </div>

            <form action="/board/write" method="POST" id="frm">
                <div class="mw_Input">
                    
                    <div class="mwInput_box">
                        <strong class="mwTit">
                            <label for="title">게시글 제목<span class="red">*<i class="hide">필수입력</i></span></label>
                        </strong>
                        <input title="게시글제목" type="text" name="title" id="title" class="mwI_full" placeholder="동네 이웃들과 나누고 싶은 소식의 제목을 적어주세요." required>
                    </div>
                    
                    <div class="mwInput_box">
                        <strong class="mwTit">
                            <label for="content">게시글 내용<span class="red">*<i class="hide">필수입력</i></span></label>
                        </strong>
                        <div class="ta_box">
                            <textarea name="content" id="content" rows="10" title="게시글내용" placeholder="자세한 소식을 작성해주세요." required></textarea>
                        </div>
                    </div>
                    
                </div>
                
                <div class="btnAreaLR" id="divButtonArea">
                    <div class="btnA_l">
                        <a href="/board" class="btn gray">
                            <span class="hide">현재 작성을 취소합니다.</span>
                            취소
                        </a>
                    </div>
                    <div class="btnA_r">
                        <button type="submit" class="btn fill" id="submitBtn">
                            <span class="hide">게시글을 등록합니다.</span>
                            작성
                        </button>
                    </div>
                </div>
            </form>
        </div>

    </div>

    <footer id="krds-footer">
        <div class="inner">
            <div class="f-btm">
                <div class="f-btm-text">
                    <div class="f-menu">
                        <a href="/terms" class="krds-btn small text">이용 안내</a>
                        <a href="/privacy" class="krds-btn small text">개인정보처리방침</a>
                        <a href="/copyright" class="krds-btn small text">저작권 정책</a>
                    </div>
                    <p class="f-copy">© 2026 Korea National University of Transportation. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

</div>
</body>
</html>