<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>내 물품 관리 - 중고마켓 동네생활</title>
    <link href="/krds/css/token/krds_tokens.css" rel="stylesheet" />
    <link href="/krds/css/common/common.css" rel="stylesheet" />
    <link href="/krds/css/component/component.css" rel="stylesheet" />
    <script defer src="/krds/js/component/ui-script.js"></script>
    <style>
        body { background-color: #ffffff; } 
        #krds-footer { background-color: #f4f6f9; margin-top: 80px; padding: 30px 0; border-top: 1px solid #e9ecef; }
        .krds-main-menu .gnb-menu > li > .gnb-main-trigger::after { display: none !important; }
        .btn-logout-fix::before, .btn-logout-fix::after { display: none !important; }
        .btn-logout-fix { display: inline-flex !important; flex-direction: row !important; align-items: center !important; gap: 4px !important; width: auto !important; white-space: nowrap !important; }
        .btn-logout-fix svg { display: block !important; margin: 0 !important; }
        .header-branding { display: flex; align-items: center; width: 100%; }
        .header-branding .logo, .header-branding .logo a { background: none !important; background-image: none !important; margin: 0; display: flex; align-items: center; }

        .subpage-container { max-width: 1000px; margin: 60px auto; padding: 0 20px; min-height: 50vh; }
        .page-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 30px; border-bottom: 2px solid #222; padding-bottom: 16px; }
        .page-title { font-size: 2.8rem; font-weight: 700; color: #111; margin: 0; }
        .btn-write { background-color: #246beb; color: #fff; border: none; padding: 10px 24px; font-size: 1.6rem; font-weight: bold; border-radius: 6px; text-decoration: none; transition: 0.2s; }

        .manage-list { width: 100%; border-collapse: collapse; border-top: 2px solid #495057; }
        .manage-list th, .manage-list td { padding: 16px; border-bottom: 1px solid #e9ecef; text-align: center; font-size: 1.5rem; vertical-align: middle; }
        .manage-list th { background-color: #f8f9fa; color: #333; font-weight: bold; }
        .manage-list td.title-col { text-align: left; font-weight: bold; color: #111; }
        
        .action-btns { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; }
        .btn { padding: 8px 12px; border-radius: 4px; font-size: 1.3rem; font-weight: bold; cursor: pointer; text-decoration: none; border: none; }
        .btn-edit { background-color: #f1f3f5; color: #495057; border: 1px solid #ced4da; }
        .btn-delete { background-color: #fff0f6; color: #e03131; border: 1px solid #ffc9c9; }
        .btn-accept { background-color: #2b8a3e; color: #fff; }
        .btn-reject { background-color: #e03131; color: #fff; }
        
        .status-badge { display: inline-block; padding: 4px 8px; font-size: 1.2rem; font-weight: bold; border-radius: 4px; color: #fff; margin-top: 5px;}
        .bg-selling { background-color: #246beb; }
        .bg-requested { background-color: #f59f00; }
        .bg-completed { background-color: #495057; }
    </style>
</head>
<body>
<div id="wrap" class="g-wrap">
    <header id="krds-header">
        <div class="header-in">
            <div class="header-container">
                <div class="inner">
                    <div class="header-branding">
                        <h1 class="logo"><a href="/" style="display: block;"><img src="/sitelogo.png" alt="사이트 로고" style="height: 45px; width: auto;"></a></h1>
                        <div class="header-actions" style="margin-left: auto;">
                            <span class="btn-navi my" style="background:none; cursor:default;"><strong><%= user.username %></strong>님</span>
                            <a href="/logout" class="btn-navi btn-logout-fix" style="text-decoration: none; color: #333;">로그아웃</a>
                        </div>
                    </div>
                </div>
            </div>
            <nav class="krds-main-menu">
                <div class="inner">
                    <ul class="gnb-menu" aria-label="메인 메뉴">
                        <li><button type="button" class="gnb-main-trigger" onclick="location.href='/info'">서비스 안내</button></li>
                        <li><button type="button" class="gnb-main-trigger" onclick="location.href='/board'">게시판</button></li>
                        <li><button type="button" class="gnb-main-trigger" onclick="location.href='/friends'">친구 관리</button></li>
                        <li><button type="button" class="gnb-main-trigger" onclick="location.href='/items'">판매 물품 정보</button></li>
                    </ul>
                </div>
            </nav>
        </div>
    </header>

    <div id="container" class="subpage-container">
        <div class="page-header">
            <h2 class="page-title">내 판매 물품 관리</h2>
            <a href="/items/write" class="btn-write">새 판매글 등록하기</a>
        </div>
        
        <table class="manage-list">
            <colgroup>
                <col style="width: 10%;">
                <col style="width: auto;">
                <col style="width: 15%;">
                <col style="width: 15%;">
                <col style="width: 20%;">
            </colgroup>
            <thead>
                <tr>
                    <th>번호</th>
                    <th>물품명 및 상태</th>
                    <th>가격</th>
                    <th>등록일</th>
                    <th>관리</th>
                </tr>
            </thead>
            <tbody>
                <% myItems.forEach(function(item, index) { %>
                <tr>
                    <td><%= index + 1 %></td>
                    <td class="title-col">
                        <a href="/items/detail/<%= item._id %>" style="color:inherit; text-decoration:none;"><%= item.title %></a>
                        <br>
                        <% if (item.status === 'selling') { %>
                            <span class="status-badge bg-selling">판매중</span>
                        <% } else if (item.status === 'requested') { %>
                            <span class="status-badge bg-requested">예약중 (요청자: <%= item.buyer %>)</span>
                        <% } else if (item.status === 'completed') { %>
                            <span class="status-badge bg-completed">판매완료 (<%= item.buyer %>님)</span>
                        <% } %>
                    </td>
                    <td><%= item.price.toLocaleString() %>원</td>
                    <td><%= item.createdAt.toLocaleDateString() %></td>
                    <td>
                        <div class="action-btns">
                            <% if (item.status === 'selling') { %>
                                <form action="/items/edit/<%= item._id %>" method="GET" style="margin:0;"><button class="btn btn-edit">수정</button></form>
                                <form action="/items/delete/<%= item._id %>" method="POST" style="margin:0;" onsubmit="return confirm('정말 삭제하시겠습니까?');"><button class="btn btn-delete">삭제</button></form>
                            <% } else if (item.status === 'requested') { %>
                                <form action="/items/accept/<%= item._id %>" method="POST" style="margin:0;"><button class="btn btn-accept">✅ 수락</button></form>
                                <form action="/items/reject/<%= item._id %>" method="POST" style="margin:0;"><button class="btn btn-reject" onclick="return confirm('요청을 거절하시겠습니까?');">❌ 거절</button></form>
                            <% } else if (item.status === 'completed') { %>
                                <span style="font-size:1.3rem; color:#888; font-weight:bold;">거래종료</span>
                            <% } %>
                        </div>
                    </td>
                </tr>
                <% }) %>
                <% if(myItems.length === 0) { %>
                    <tr><td colspan="5" style="padding:40px; color:#888;">등록하신 물품이 없습니다.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <footer id="krds-footer">
        <div class="inner">
            <div class="f-btm">
                <div class="f-btm-text">
                    <p class="f-copy">© 2026 Korea National University of Transportation. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>
</div>
</body>
</html>